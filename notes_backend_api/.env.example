# Server
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# CORS
# Must match frontend origin (React dev server typically http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Auth / JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
COOKIE_NAME=access_token

# Database (PostgreSQL)
# Provide a full connection string OR discrete params (connection string preferred).
DATABASE_URL=postgresql://user:password@localhost:5432/notes_app
# Optional:
PGSSL=false
